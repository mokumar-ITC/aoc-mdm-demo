{
  // Copy to appsettings.json and appsettings.Development.json, then fill in the CHANGE_ME values.
  // Those copies are git-ignored; do not commit real credentials.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "AOC_MDM_MetaData_GUI"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DatabricksConnection": "Driver={PostgreSQL ODBC Driver(UNICODE)};Server=localhost;Port=5432;Database=aoc_mdm;Uid=postgres;Pwd=CHANGE_ME;BoolsAsChar=0;"
  },
  "DatabaseSettings": {
    "Catalog": "aoc_mdm"
  },
  "Demo": {
    "ShowDemoAccounts": false, // lists demo accounts on the login page - Development only
    "Password": "CHANGE_ME"
  },
  "Authentication": {
    "Mode": "Forms" // "Forms" = login page; "Windows" = Windows SSO (Negotiate)
  },
  "UserRoles": {
    "EnableRoleCheck": true, // true: role comes from the signed-in user (intranet.user_access); false: HardcodedRole below, no login (testing only)
    "HardcodedRole": {
      "UserName": "CHANGE_ME",
      "LevelNo": 4
    }
  },
  "EmailSettings": {
    "EmailTo": "CHANGE_ME@example.com",
    "EmailCC": "CHANGE_ME@example.com",
    "SupportEmail": "CHANGE_ME@example.com",
    "SupportPhone": "CHANGE_ME"
  }
}
