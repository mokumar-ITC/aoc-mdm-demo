@{
    Layout = null;
    var demoAccounts = ViewBag.DemoAccounts as List<AOC_MDM.Core.Entities.UserAccount>;
    var levelInfo = new Dictionary<int, string>
    {
        [1] = "View all data",
        [2] = "View + submit changes for approval",
        [3] = "Approve / reject + edit hierarchy",
        [4] = "Everything + manage users"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - IT Convergence MDM MetaData</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f3f6f9; min-height: 100vh; }
        .login-card { max-width: 420px; border: 0; border-top: 4px solid #002b5c; }
        .brand-title { color: #0391e8; font-weight: 500; }
        .btn-signin { background: #002b5c; border-color: #002b5c; }
        .btn-signin:hover { background: #0391e8; border-color: #0391e8; }
        .demo-table tbody tr { cursor: pointer; }
        .demo-table tbody tr:hover { background: #e5eff7; }
    </style>
</head>
<body class="d-flex flex-column align-items-center justify-content-center py-5 px-3">
    <div class="card shadow-sm login-card w-100">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <img src="~/images/itconvergence-logo.png" height="60" alt="IT Convergence" asp-append-version="true" />
                <h4 class="brand-title mt-3 mb-0">MDM MetaData</h4>
                <div class="text-muted small">Master Data Governance</div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2" role="alert">@ViewBag.Error</div>
            }

            <form asp-action="Login" method="post" autocomplete="off">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label for="login" class="form-label">User name</label>
                    <input id="login" name="login" class="form-control" value="@ViewBag.Login" required autofocus />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input id="password" name="password" type="password" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary btn-signin w-100">Sign in</button>
            </form>
        </div>
    </div>

    @if (demoAccounts != null && demoAccounts.Any())
    {
        <div class="card shadow-sm mt-3 w-100" style="max-width: 640px;">
            <div class="card-body p-3">
                <h6 class="mb-1">Demo accounts</h6>
                <p class="text-muted small mb-2">
                    Click a row to fill in the user name.
                    @if (!string.IsNullOrEmpty(ViewBag.DemoPassword as string))
                    {
                        <span>Password for all demo accounts: <code>@ViewBag.DemoPassword</code></span>
                    }
                </p>
                <table class="table table-sm table-bordered demo-table mb-0 small">
                    <thead class="table-light">
                        <tr><th>User name</th><th>Name</th><th>Role</th><th>Can do</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in demoAccounts)
                        {
                            <tr data-login="@a.Login">
                                <td><code>@a.Login</code></td>
                                <td>@a.DisplayName</td>
                                <td>@a.LevelDesc (@a.LevelNo)</td>
                                <td>@(levelInfo.TryGetValue(a.LevelNo, out var info) ? info : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="text-muted small mt-4">&copy; 2026 - IT Convergence MDM MetaData</div>

    <script>
        document.querySelectorAll('.demo-table tbody tr').forEach(function (row) {
            row.addEventListener('click', function () {
                document.getElementById('login').value = row.dataset.login;
                document.getElementById('password').focus();
            });
        });
    </script>
</body>
</html>
