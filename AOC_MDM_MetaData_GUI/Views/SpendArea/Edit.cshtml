@model AOC_MDM.Services.DTO.MDMSpendAreaDTO

@{
    ViewData["Title"] = "Edit";
}

<div>
    <h2>Edit</h2>

    <a asp-action="Index" class="btn btn-primary float-end" onclick="showloader()">Back to List</a>
</div>
<h4>Spend Area</h4>

<hr />

<form asp-action="Edit" asp-route-id="@Model.spend_area">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="p-2 row row-cols-4">
        <div class="form-group">
            <label asp-for="spend_area" class="control-label">Spend Area</label>
            <input asp-for="spend_area" readonly class="form-control" />
            <span asp-validation-for="spend_area" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Enabled" class="control-label"></label>
            <select asp-for="Enabled" name="Enabled" class="form-select">
                <option value="Yes">Yes</option>
                <option value="No">No</option>
            </select>
            <span asp-validation-for="Enabled" class="text-danger"></span>
        </div>
        <div>
            <br />
            <input type="submit" value="Save" class="btn btn-primary float-end" onclick="showloader()" />
        </div>
    </div>
 </form>
@{
    await Html.RenderPartialAsync("_LoaderPartial");
}

