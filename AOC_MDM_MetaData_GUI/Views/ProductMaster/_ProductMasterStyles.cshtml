<style>
    .pm-stat { border: 1px solid #dee2e6; border-radius: 6px; padding: 8px 12px; background: #fff; }
    .pm-stat-value { font-size: 1.6rem; font-weight: 600; color: #002b5c; line-height: 1.1; }
    .pm-stat-label { color: #6c757d; font-size: .95rem; }
