    .pm-link:hover { text-decoration: underline; }
    .pm-level-1 > .pm-row > .pm-link { font-weight: 600; }
    .pm-count { flex: none; font-size: .85rem; color: #6c757d; background: #eef2f6; border-radius: 10px; padding: 0 7px; }
    .pm-match > .pm-row > .pm-link { background: #fff3cd; }

    .pm-level-badge { background: #002b5c; font-size: .75rem; font-weight: 500; }
    .pm-chip { background: #eef6fd; color: #035f99; border: 1px solid #bfe0f7; font-weight: 500; margin: 0 4px 4px 0; font-size: .9rem; }
