@model IEnumerable<AOC_MDM.Core.Entities.HierarchyAuditEntry>
@{
    ViewData["Title"] = "Hierarchy History";
    string selected = ViewBag.LevelName as string ?? "";
}

<div class="pt-3">
    <h4>Hierarchy History</h4>
    <p class="text-muted small mb-2">Every add, change, rename, enable/disable and delete in the vendor hierarchy, newest first (last 500).</p>

    <form method="get" class="row g-2 mb-2" style="max-width: 760px;">
        <div class="col-sm-4">
            <select name="levelName" class="form-select">
                <option value="">All levels</option>
                @foreach (var l in new[] { "Spend Area", "Team", "Level 1", "Level 2", "Level 3" })
                {
                    <option value="@l" selected="@(l == selected)">@l</option>
                }
            </select>
        </div>
        <div class="col-sm-5">
            <input name="search" class="form-control" placeholder="Name, change or user" value="@ViewBag.Search" />
        </div>
        <div class="col-sm-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="History" class="btn btn-primary">Reset</a>
        </div>
    </form>

    <table class="table table-bordered" id="table" data-toggle="table" data-pagination="true" data-page-size="25">
        <thead class="tb-header">
            <tr>
                <th data-sortable="true">When</th>
                <th data-sortable="true">Level</th>
                <th data-sortable="true">Name</th>
                <th data-sortable="true">Action</th>
                <th>Changes</th>
                <th data-sortable="true">By</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                var badge = h.Action switch
                {
                    "INSERT" => "alert-success", "DELETE" => "alert-danger", "RENAME" => "alert-warning", _ => "alert-info"
                };
                <tr>
                    <td class="text-nowrap">@h.ChangedAt.ToString("dd-MM-yyyy HH:mm:ss")</td>
                    <td>@h.LevelName</td>
                    <td>@h.RecordKey</td>
                    <td><span class="badge rounded-pill @badge">@h.Action</span></td>
                    <td class="small">@h.Changes</td>
                    <td>@h.ChangedBy</td>
                </tr>
            }
        </tbody>
    </table>
</div>
