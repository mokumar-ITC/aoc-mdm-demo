    $('#filterType').val("@Model.filterColumnName");
    $('#filterValue').val("@Model.filterValue");
    $('#pageSize').val(@Model.pageSize);
    $("#pageSize").change(function () {
        $("#divLoading").show();
        var pageSize = $('select[id=pageSize]').val();
        var selectedPageColumns = JSON.stringify($("#table").bootstrapTable('getVisibleColumns').map(function (it) {
            return it.title.trim();
        }))
        var url = '@Url.Action("BulkUpdate", "ItemSupplierRefAttri")' + '?pageNumber=' + 1 + '&pageSize=' + pageSize + '&filterColumnName=' + '@Model.filterColumnName' + '&filterValue=' + '@Model.filterValue' + '&selectedPageColumns=' + selectedPageColumns; // Change to your desired URL window.open(url, '_blank');
        window.location.href = url;
    })

    function searchClick() {
        $("#divLoading").show();
        var pageSize = $('select[id=pageSize]').val();
        var selectedPageColumns = JSON.stringify($("#table").bootstrapTable('getVisibleColumns').map(function (it) {
            return it.title.trim();
        }))
        var url = '@Url.Action("BulkUpdateSearch", "ItemSupplierRefAttri")' + '?pageNumber=' + '@Model.pageNumber' + '&pageSize=' + 1 + '&filterColumnName=' + $('select[name=filterType]').val() + '&filterValue=' + $('#filterValue').val() + '&statusValue=' + $('select[id=statusValue]').val() + '&formula=' + $('select[id=formula]').val() + '&selectedPageColumns=' + selectedPageColumns; // Change to your desired URL window.open(url, '_blank');
        window.location.href = url;
    }
    function toggleCheckboxes() {
        const checkboxes = document.querySelectorAll('.toggleCheckbox');
        const select_all = document.querySelectorAll('.select_all');
        const button = document.getElementById('Savebutton');
        const button1 = document.getElementById('Savebutton1');
        //select_all[0].checked = !select_all[0].checked
        //alert(select_all[0].checked, select_all[1].checked)
        checkboxes.forEach(checkbox => {
            if (select_all[0].checked) {
                checkbox.checked = true;
                button.disabled = !checkbox.checked;
                button1.disabled = !checkbox.checked;
            }
            else {
                checkbox.checked = false;
                button.disabled = !checkbox.checked;
                button1.disabled = !checkbox.checked;
            }
        });
    }
    function onCheckEvent() {
        const button = document.getElementById('Savebutton');
        const button1 = document.getElementById('Savebutton1');
        button.disabled = true;
        button1.disabled = true;
        const checkboxes = document.querySelectorAll('.toggleCheckbox');
        checkboxes.forEach(checkbox => {
            if (checkbox.checked == true) {
                button.disabled = false;
                button1.disabled = false;
            }
        }
        )
    }

    // init bootpag

    $('.pagination').bootpag({
        total: @Model.totalPages,
        page: @Model.pageNumber,
        maxVisible: 10,
        leaps: true,
        firstLastUse: true,
        first: '←',
        last: '→',
        wrapClass: 'pagination',
        activeClass: 'active',
        disabledClass: 'disabled',
        nextClass: 'next',
        prevClass: 'prev',
        lastClass: 'last',
        firstClass: 'first'
    }).on("page", function (event, num) {
        var selectedPageColumns = JSON.stringify($("#table").bootstrapTable('getVisibleColumns').map(function (it) {
            return it.title.trim();
        }))
        // alert(aa);
        $("#divLoading").show();
        var url = '@Url.Action("BulkUpdate", "ItemSupplierRefAttri")' + '?pageNumber=' + num + '&pageSize=' + '@Model.pageSize' + '&filterColumnName=' + '@Model.filterColumnName' + '&filterValue=' + '@Model.filterValue' + '&selectedPageColumns=' + selectedPageColumns; // Change to your desired URL window.open(url, '_blank');
        window.location.href = url;

    });

    $("#statusValue").hide();
    $("#formula").hide();
    $("#filterType").change(function () {
        var filterType = $('select[name=filterType]').val();
        if (filterType == "UpdateStatus") {
            $("#filterValue").hide();
            $("#filterValue").val("");
            $("#statusValue").show();
            $("#formula").hide();
            $("#formula").val("");
        } else if (filterType == "formula_non_formula") {
            $("#filterValue").hide();
            $("#filterValue").val("");
            $("#statusValue").hide();
            $("#statusValue").val("");
            $("#formula").show();
        } else {
            $("#filterValue").val("");
            $("#filterValue").show();
            $("#statusValue").val("");
            $("#statusValue").hide();
            $("#formula").hide();
            $("#formula").val("");
        }
    });

