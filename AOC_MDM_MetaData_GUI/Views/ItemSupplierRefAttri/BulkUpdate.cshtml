@using System.Linq
@model dynamic
@{
    ViewData["Title"] = "Index";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/x-editable@1.5.11/dist/bootstrap3-editable/css/bootstrap-editable.css">
<script src="https://cdn.jsdelivr.net/npm/x-editable@1.5.11/dist/bootstrap3-editable/js/bootstrap-editable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.0/dist/extensions/editable/bootstrap-table-editable.min.js"></script>
@*
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.0/dist/extensions/fixed-columns/bootstrap-table-fixed-columns.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.0/dist/extensions/fixed-columns/bootstrap-table-fixed-columns.min.js"></script> *@

<div class="pt-3">
    @if (TempData["alertMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["alertMessage"]
            <button type="button" class="btn-close" data-dismiss="alert" aria-label="Close">
            </button>
        </div>
    }
    <h4>Item Supplier Bulk Update</h4>

    <form method="post" asp-action="BulkUpdate">
        <div id="toolbar">

            <div class="row row-cols-4">
                <div class="col">
                    <select id="filterType" name="filterType" class="form-select">
                        <option value="">Select</option>
                        <option value="source">Source</option>
                        <option value="item_id">Item Id</option>
                        <option value="item_description">Item Description</option>
                        <option value="vendor_id">Vendor Id</option>
                        <option value="vendor_name">Vendor Name</option>                        
                        <option value="vendor_number">Vendor Number</option>
                         <option value="spend_area">Spend Area</option>
                        <option value="UpdateStatus">Status</option>
                        <option value="UpdatedDate">Updated Date</option>
                        <option value="risk_transfer"> Risk Transfer</option>
                        <option value="item_no">Item No</option>
                        <option value="supplier_specific_requirements">Supplier Specific Requirements</option>
                        <option value="formula_non_formula">Formula Non-Formula</option>
                    </select>
                    <input name="pageNumber" value="@Model.pageNumber" style="display:none" />
                    <input name="pageSize" value="@Model.pageSize" style="display:none" />
                    <input name="filterColumnName" value="@Model.filterColumnName" style="display:none" />
                </div>
                <div class="col form-group">
                    <input id="filterValue" name="filterValue" class="form-control" />
                    <select id="statusValue" name="statusValue" class="form-select">
                        <option value="">Select</option>
                        <option value="PendingApproval">Pending Approval</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                        <option value="UpdateDirectly">Update Directly</option>
                        <option value="New">New</option>
                    </select>
                    <select id="formula" name="formula" class="form-select">
                        <option value="">Select</option>
                        <option value="Formula">Formula</option>
                        <option value="Non-Formula">Non-Formula</option>
                    </select>
                </div>
                <div class="col form-group">
                    <input value="Filter" type="button" class="btn btn-primary" onclick="searchClick()" />
                    <a class="btn btn-primary" asp-action="BulkUpdate" onclick="showloader()">  Reset</a>
                </div>
                <div class="col">
                   <button id="Savebutton1" type="submit" class="btn btn-primary" onclick="showloader()" disabled>Save Changes</button>
                </div>
            </div>

        </div>

   @*      <div id="hidden-fields" style="display: none;">
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
              
                <input type="hidden" name="Items[@i].RiskTransfer" value="@item.RiskTransfer" />
                <input type="hidden" name="Items[@i].SupplierSpecificRequirements" value="@item.SupplierSpecificRequirements" />
                <input type="hidden" name="Items[@i].FormulaNonFormula" value="@item.FormulaNonFormula" />
               
            }
        </div> *@

        <table class="table table-bordered" id="table"
               data-toggle="table"
               data-toolbar="#toolbar"
               data-show-columns-search="true"
               data-sort-name="name"
               data-sort-order="desc"
               data-show-columns="true"
               data-buttons-align="right"
               data-search="true"
               data-show-fullscreen="true"
               data-page-size="10"
               data-page-number="1">
            <thead class="tb-header">
                <tr>
                    <th data-switchable="false">
                        <input type="checkbox" id="select_all" class="select_all" onchange="toggleCheckboxes()" />
                    </th>
                    @* <th data-checkbox="true"></th> *@
                    <th data-sortable="true" data-editable="true">
                        Source
                    </th>
                    <th data-sortable="true" data-editable="true">
                        Item Number
                    </th>
                    <th data-sortable="true" @(Model.filterColumnName == "item_id" ? "" : (GetColumn("Item Id", Model.selectedPageColumns) ? "" : "data-visible=false"))>
                        Item Id
                    </th>

                    <th data-sortable="true">
                        @* @(Model.filterColumnName == "item_description" ? "" : "data-visible=false") *@
                        Item Description
                    </th>
                    <th data-sortable="true" @(Model.filterColumnName == "vendor_id" ? "" : (GetColumn("Vendor Id", Model.selectedPageColumns) ? "" : "data-visible=false"))>

                        Vendor Id
                    </th>
                    <th data-sortable="true">
                        Vendor Name
                    </th>
                    <th data-sortable="true">
                        Vendor Number
                    </th>

                    <th data-sortable="true" data-switchable="false">

                        Risk Transfer
                    </th>
                    <th data-sortable="true" data-switchable="false">
                        Supplier Specific Requirements
                    </th>
                    <th data-sortable="true" data-switchable="false">

                        Formula Non Formula
                    </th>
                    <th data-sortable="true" data-switchable="false" )>

                       SpendArea
                    </th>

                    <th data-sortable="true" @(Model.filterColumnName == "UpdateStatus" ? "" : (GetColumn("Status", Model.selectedPageColumns) ? "" : "data-visible=false"))>

                        Status
                    </th>
                    <th data-sortable="true" @(Model.filterColumnName == "UpdatedDate" ? "" : (GetColumn("Updated Date", Model.selectedPageColumns) ? "" : "data-visible=false"))>


                        Updated Date
                    </th>
                </tr>
            </thead>
            <tbody>

                @if (Model != null && Model.Items != null)
                {
                    for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr>
                            @* <td></td> *@
                            <td>
                                <input type="checkbox" class="toggleCheckbox" onchange="onCheckEvent()" name="Items[@i].IsSelected" value="true" @(item.IsSelected ? "checked" : "") />
                                <input style="display:none" id="txt_edit_ItemId_" value="@item.ItemId" name="Items[@i].ItemId" readonly />
                                <input style="display:none" id="txt_edit_VendorId_" value="@item.VendorId" name="Items[@i].VendorId" readonly />
                            </td>
                            <td>
                                <input id="txt_edit_Source" value="@item.Source" title="@item.Source" name="Items[@i].Source" class="form-control" readonly />
                                @*   @item.Source *@
                            </td>
                            <td>
                                <input id="txt_edit_ItemNo" value="@item.ItemNo" title="@item.ItemNo" name="Items[@i].ItemNo" class="form-control" readonly />
                                @*  @item.ItemNo  *@
                            </td>
                            <td>
                                <input id="txt_edit_ItemId" value="@item.ItemId" title="@item.ItemId" name="Items[@i].ItemId" class="form-control" readonly />

                            </td>
                            <td>
                                <input id="txt_edit_ItemDescription" value="@item.ItemDescription" title="@item.ItemDescription" name="Items[@i].ItemDescription" class="form-control" readonly />
                            </td>
                            <td>
                                <input id="txt_edit_VendorId" value="@item.VendorId" title="@item.VendorId" name="Items[@i].VendorId" class="form-control" readonly />

                            </td>
                            <td>    
                                <input id="txt_edit_VendorName" value="@item.VendorName" title="@item.VendorName" name="Items[@i].VendorName" class="form-control" readonly />

                            </td>
                            <td>
                                <input id="txt_edit_VendorNumber" value="@item.VendorNumber" title="@item.VendorNumber" name="Items[@i].VendorNumber" class="form-control" readonly />

                            </td>

                            <td>
                                <input id="txt_edit_RiskTransfer" value="@item.RiskTransfer" title="@item.RiskTransfer" name="Items[@i].RiskTransfer" class="form-control" />
                            </td>

                            <td>
                                <input id="txt_edit_SupplierSpecificRequirements" title="@item.SupplierSpecificRequirements" value="@item.SupplierSpecificRequirements" name="Items[@i].SupplierSpecificRequirements" class="form-control" />

                            </td>
                            <td>

                                <select id="txt_edit_FormulaNonFormula" name="Items[@i].FormulaNonFormula" title="@item.FormulaNonFormula" class="form-select">
                                    @Html.Raw(GetSelectOptions(@item.FormulaNonFormula))
                                </select>
                             
                            </td>
                              <td>
                                <input id="txt_edit_SpendArea" value="@item.SpendArea" title="@item.SpendArea" name="Items[@i].SpendArea" class="form-control" readonly />

                            </td>
                            <td>
                                <span class="@(item.UpdateStatus=="PendingApproval" ? "badge rounded-pill alert-warning" :
                                     item.UpdateStatus=="Approved" ? "badge rounded-pill alert-success" :
                                      item.UpdateStatus=="UpdateDirectly" ? "badge rounded-pill alert-info" :
                                     item.UpdateStatus=="Rejected" ? "badge rounded-pill alert-danger" : string.Empty)">
                                    @item.UpdateStatus
                                </span>
                            </td>
                            <td>
                                @(item.UpdatedDate?.ToString("dd-MM-yyyy HH:mm:ss"))
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No Item found.</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="row row-cols-2 pt-3">
            <div>
                Showing @Model.toPageNumber to @Model.fromPageNumber of @Model.TotalCount rows
                <select id="pageSize" name="pageSize" style="width:70px">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <nav aria-label="Page navigation ">
                <div class="pagination float-end"></div>
            </nav>
        </div>
        <div class="d-flex justify-content-between pt-3">
            <div>
            </div>
            <button id="Savebutton" type="submit" class="btn btn-primary" onclick="showloader()" disabled>Save Changes</button>
        </div>

    </form>
</div>
@{
    await Html.RenderPartialAsync("_LoaderPartial");
}
